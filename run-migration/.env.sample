# Copy to .env (next to migrate.sh) and adjust.
# Relative paths are resolved against the directory of this file.

# Docker build context for the migration image (optional).
# If set, the image is built from these local files; if empty, it is pulled.
CODE_DIR=

# Name and tag of the migration image that is pulled/built and run
DOCKER_IMAGE=bluespice/migrate-confluence
DOCKER_TAG=latest

# Deployment directory, e.g. /opt/bluespice/data/wiki/bluespice
# (optional, created if missing; leave empty to skip deployment)
TARGET_DIR=

# Parallel processes for analyze/convert/compose
WORKERS=4