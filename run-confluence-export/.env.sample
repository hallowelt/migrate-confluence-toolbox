# Copy to .env (next to migrate.sh) and adjust.
# Relative paths are resolved against the directory of this file.

# Docker build context for the migration image
CODE_DIR=code

# Name/tag of the migration image that is built and run
DOCKER_IMAGE=bluespice/migrate-confluence:latest

# BlueSpice installation directory (optional; leave empty to skip deployment)
TARGET_DIR=

# Path below TARGET_DIR the result is copied to (relative, no "..")
DEPLOY_PATH=data/wiki/bluespice

# Parallel processes for analyze/convert/compose
WORKERS=4